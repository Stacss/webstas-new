APP_ENV=production

# Оператор персональных данных и исполнитель
OPERATOR_FULL_NAME=
OPERATOR_STATUS=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_ADDRESS=
HOSTING_PROVIDER=
MAIL_PROVIDER=

# Принятые оператором сроки. Измените, если фактический порядок отличается.
REQUEST_RETENTION="12 месяцев с даты последнего содержательного взаимодействия по обращению"
TECHNICAL_LOG_RETENTION="30 календарных дней"
CONSENT_DURATION="в течение 12 месяцев с даты последнего содержательного взаимодействия по обращению либо до отзыва согласия, если он наступит раньше"

# SMTP с первичным хранением данных на территории РФ
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=info@webstas.ru
FORM_TO_EMAIL=info@webstas.ru

# Не менее 32 случайных символов. Пример генерации: openssl rand -hex 32
ALTCHA_HMAC_KEY=

# В production укажите каталог вне публичного web-root
RATE_LIMIT_DIR=
USED_CHALLENGE_DIR=
